# Dockerfile.sse - Pour exécuter le service SSE en container (OPTIONNEL)
# À utiliser si vous voulez isoler SSE dans un microservice distinct

FROM python:3.11-slim

WORKDIR /app

# Installer les dépendances système
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copier les requirements
COPY requirements.txt .
COPY sse/requirements-sse.txt .

# Installer les dépendances Python
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir -r requirements-sse.txt

# Copier le code
COPY . .

# Port pour le service SSE
EXPOSE 8001

# Commande de démarrage (optionnel - serve le module SSE seul)
CMD ["python", "-m", "uvicorn", "sse.routes:app", "--host", "0.0.0.0", "--port", "8001"]
